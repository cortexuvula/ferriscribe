<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- pdfium (scanned-PDF OCR) is downloaded into the app data dir at runtime
         and ad-hoc signed there — outside the notarized bundle. Hardened Runtime
         library validation would reject loading a non-Team-ID-signed dylib; this
         entitlement permits loading it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
