{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerriScribe",
  "version": "0.56.0",
  "identifier": "com.ferriscribe.app",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FerriScribe",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "msi", "nsis", "dmg", "app"],
    "externalBin": ["binaries/ferriscribe-backup"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ferriscribe"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMjg1MzI2QUI4NDBFQQpSV1RxUUxocU1vV3lDWVNoUm55ZDB5akpRc3g0bFhHZzNQblNoelBKZGxwNnl6RVFFeTArQ2VKego=",
      "endpoints": [
        "https://github.com/cortexuvula/ferriscribe/releases/latest/download/latest.json"
      ]
    }
  }
}
