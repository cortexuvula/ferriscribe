{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the screen-region selection overlay",
  "windows": ["main", "screen-region-overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:default"
  ]
}
