# Maintainer: Andre Hugo <cortexpeterpan@gmail.com>
# AUR package for the prebuilt FerriScribe release .deb (the -bin pattern).
# Update per release: bump pkgver, refresh sha256sums (command in README.md),
# regenerate .SRCINFO with `makepkg --printsrcinfo > .SRCINFO`.

pkgname=ferriscribe-bin
pkgver=0.72.0
pkgrel=1
pkgdesc='Local-first medical scribe: dictation to SOAP notes with on-device AI (no cloud, PHI stays local)'
arch=('x86_64')
url='https://github.com/cortexuvula/ferriscribe'
license=('LicenseRef-Proprietary')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'libayatana-appindicator'
  'hicolor-icon-theme'
)
makedepends=('binutils' 'libarchive')
provides=('ferriscribe')
conflicts=('ferriscribe')
source=("FerriScribe_${pkgver}_amd64.deb::https://github.com/cortexuvula/ferriscribe/releases/download/v${pkgver}/FerriScribe_${pkgver}_amd64.deb")
noextract=("FerriScribe_${pkgver}_amd64.deb")
sha256sums=('4293bdf1d95991bb2a32ea456d72d4846031e2a7dad85b90677ab644b78a0203')

package() {
  cd "${srcdir}"

  # The .deb is an `ar` archive containing control.tar.* + data.tar.*;
  # libarchive's bsdtar reads the ar container, then auto-detects the
  # member's compression (zstd/xz/gz) on the second pass.
  bsdtar -xf "${srcdir}/FerriScribe_${pkgver}_amd64.deb"
  bsdtar -xf data.tar.* -C "${pkgdir}"

  # The deb installs the binary as `rust-medical-assistant` (the Cargo
  # package name) and its desktop entry's Exec= points at that. Rename the
  # binary to match the package name and patch ONLY Exec= — Icon= and
  # StartupWMClass= keep referencing rust-medical-assistant, which stays
  # consistent with the installed icon names and the app's WM class.
  if [ -f "${pkgdir}/usr/bin/rust-medical-assistant" ]; then
    mv "${pkgdir}/usr/bin/rust-medical-assistant" "${pkgdir}/usr/bin/ferriscribe"
    sed -i 's/^Exec=rust-medical-assistant/Exec=ferriscribe/' \
      "${pkgdir}/usr/share/applications/FerriScribe.desktop"
  fi
}
